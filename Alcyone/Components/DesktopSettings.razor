@inherits LocalizedComponent
@inject DesktopPreferences Preferences
@inject DesktopWallpaperService Desktop
<button class="desktop-settings-entry" @onclick="() => _open = true"><span>@L["桌面与启动"]</span><small>@L["开机自启与桌面恢复"]</small><span>›</span></button>
@if (_open)
{
    <div class="desktop-settings-backdrop" data-overlay-dismiss @onclick="() => _open = false">
        <section class="desktop-settings-dialog" role="dialog" aria-modal="true" aria-label="@L["桌面设置"]" @onclick:stopPropagation="true">
            <h2>@L["桌面设置"]</h2>
            <label><input type="checkbox" checked="@Preferences.AutoStart" disabled="@(!Desktop.Available)" @onchange="SetAutoStart" />@L["登录 Windows 后自动启动"]</label>
            <label><input type="checkbox" checked="@Preferences.RestoreDesktop" @onchange="SetRestore" />@L["启动时恢复上次启用的桌面"]</label>
            <label><input type="checkbox" checked="@Preferences.FilePackingAnimation" @onchange="SetFilePacking" />@L["删除桌面文件时播放星舰打包动画"]</label>
            <button class="btn" disabled="@(!Desktop.IsDesktop)" @onclick="() => { _open=false; Desktop.PreviewFilePacking(); }">@L["预览星舰打包动画"]</button>
            <p>@L["桌面卡片和星球可拖动，选中卡片可折叠，双击星球可展开。位置与折叠状态自动保存。"]</p>
            @if (_error is not null) { <p role="alert">@L[_error]</p> }
            <button class="btn" @onclick="() => _open = false">@L["完成"]</button>
        </section>
    </div>
}
@code {
    private void SetFilePacking(ChangeEventArgs args) { try { Preferences.SetFilePacking(args.Value is true); _error=null; } catch(Exception ex) { _error=ex.Message; } }
    private bool _open;
    private string? _error;
    private void SetAutoStart(ChangeEventArgs args) { try { Preferences.SetAutoStart(args.Value is true); _error = null; } catch (Exception ex) { _error = ex.Message; } }
    private void SetRestore(ChangeEventArgs args) { try { Preferences.SetRestore(args.Value is true); _error = null; } catch (Exception ex) { _error = ex.Message; } }
}

