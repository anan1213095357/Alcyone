<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    @if (IsTraining)
    {
        <link rel="stylesheet" href="training/app.css" />
        <link rel="stylesheet" href="training/text-finder.css" />
        <link rel="stylesheet" href="training/scrollbars.css" />
        <link rel="stylesheet" href="training/integration.css" />
    }
    else
    {
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Alcyone.styles.css"]" />
    }
    <link rel="stylesheet" href="@Assets["number-inputs.css"]" />
    <link rel="stylesheet" href="@Assets["select-inputs.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    @if (IsTraining)
    {
        <script src="training/annotation.js"></script>
        <script src="training/text-annotation.js"></script>
    }
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private bool IsTraining => HttpContext.Request.Path.StartsWithSegments("/recognition-training");
}
