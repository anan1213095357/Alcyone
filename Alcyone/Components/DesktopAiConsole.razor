@inherits LocalizedComponent
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject DesktopWallpaperService Desktop
@inject IJSRuntime JS
@inject StateMachine.Localization.UiText Text
<section class="desktop-ai-console" aria-label="@Text["桌面 AI 对话"]">
    @if (_hasReply || _busy || CliBusy || !string.IsNullOrEmpty(CliPreview))
    {
        <div class="ai-response" aria-live="polite">
            <span class="response-dot"></span><div class="ai-response-body">
            <div class="ai-reply"><AiMarkdown Text="@(_busy ? Text["星际通讯中…"] : Text[Reply])" /></div><AiStreamView Progress="Progress" Busy="_busy" JsonReply="true" />
            @if (!string.IsNullOrEmpty(CliPreview))
            {
                <section class="cli-review"><strong>@Text["待执行 · PowerShell"]</strong><pre>@CliPreview</pre><div><button type="button" @onclick="CancelCli">@Text["取消"]</button><button type="button" class="cli-run" @onclick="ExecuteCli">@Text["执行命令"]</button></div></section>
            }
            @if (!string.IsNullOrEmpty(CliStatus))
            {
                <section class="cli-result"><strong>@Text[CliStatus]</strong>@if (CliBusy) {
                    <button type="button" @onclick="CancelCli">@Text["停止"]</button>
                }
                <pre>@CliOutput</pre></section>
            }
        </div><div class="ai-response-actions"><button type="button" @onpointerdown:preventDefault="true" @onclick="CopyReply" title="@Text["复制"]" aria-label="@Text["复制"]">⧉</button><button type="button" @onclick="() => _hasReply = false" aria-label="@Text["收起回复"]">×</button></div>
    </div>
}
@if (_focused && !_busy && Suggestions.Any())
{
    <div class="ai-suggestions" role="listbox" aria-label="@Text["指令联想"]">
        @{
            var matches = Suggestions.ToList();
        }
        @for (var i = 0; i < matches.Count; i++)
        {
            var suggestion = matches[i]; var index = i;
            <button type="button" role="option" aria-selected="@(index == _index)" class="@(index == _index ? "active" : "")" @onpointerdown:preventDefault="true" @onpointerdown="() => Choose(suggestion)"><span>@suggestion@if (AiWorkflowExamples.All.FirstOrDefault(e => Text[e.Title] == suggestion) is { } example) { <em>@Text[example.Description]</em> }</span><small>↗</small></button>
        }
    </div>
}
<form class="ai-input-bar" @onsubmit="Send" @onsubmit:preventDefault="true">
    <img class="ai-spark ai-brand" src="images/planet-logo-transparent.png" alt="Alcyone" />
    <textarea rows="1" data-auto-grow @ref="_field" data-native-input="@_inputId" value="@_input" readonly placeholder="@Text["描述电脑操作，或输入 /cli 命令…"]" aria-label="@Text["桌面 AI 指令"]" autocomplete="off" title="@Text["Enter 发送 · Shift+Enter 换行 · Ctrl+A 全选"]"></textarea>
    <button type="submit" class="ai-send @(_busy ? "busy" : "")" disabled="@(_busy || CliBusy || string.IsNullOrWhiteSpace(_input))" aria-label="@Text["发送指令"]">
        @if (_busy)
        {
            <span class="send-loader"></span>
        }
        else
        {

            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 18V6m-5 5 5-5 5 5" /></svg>
        }
    </button>
</form>
</section>
@code {
    [Parameter] public EventCallback<string> Submit { get; set; }
    [Parameter] public string Reply { get; set; } = "";
    [Parameter] public AiStreamProgress? Progress { get; set; }
    [Parameter] public string CliPreview { get; set; } = "";
    [Parameter] public string CliOutput { get; set; } = "";
    [Parameter] public string CliStatus { get; set; } = "";
    [Parameter] public bool CliBusy { get; set; }
    [Parameter] public EventCallback ExecuteCli { get; set; }
    [Parameter] public EventCallback CancelCli { get; set; }
    [Parameter] public IEnumerable<string> StateNames { get; set; } = [];
    [Parameter] public IEnumerable<string> VariableNames { get; set; } = [];
    private bool _busy, _focused, _hasReply;
    private int _index;
    private string _input = "";
    private readonly string _inputId = Guid.NewGuid().ToString("N");
    protected override void OnInitialized() => Desktop.TextInput.Changed += NativeInputChanged;
    private void NativeInputChanged(DesktopTextInput.Update update)
    {
        if (update.Id != _inputId) return;
        _ = InvokeAsync(async () => { _input = update.Text; _focused = update.Active; if (update.Submit) await Send(); StateHasChanged(); });
    }
    public void Dispose() => Desktop.TextInput.Changed -= NativeInputChanged;
    public override ValueTask DisposeAsync() { Dispose(); return base.DisposeAsync(); }
    private ElementReference _field;
    private IEnumerable<string> Suggestions => AiWorkflowExamples.All.Select(e => Text[e.Title]).Concat(new[] { "启动状态机", "停止状态机", "执行单步" }.Select(s => Text[s])).Concat(StateNames.Select(s => Text.Format("切换到 {0}", s))).Concat(StateNames.Select(s => Text.Format("将 {0} 设为起始状态", s))).Concat(VariableNames.Select(v => Text.Format("把 {0} 设为 ", v))).Where(s => string.IsNullOrWhiteSpace(_input) || s.Contains(_input.Trim(), StringComparison.OrdinalIgnoreCase)).Distinct().Take(6);
    private void InputChanged(ChangeEventArgs e) { _input = e.Value?.ToString() ?? ""; _index = 0; }
    private string? _chosenText;
    private Task Choose(string text) { text = AiWorkflowExamples.All.FirstOrDefault(e => Text[e.Title] == text) is { } example ? Text[example.Prompt] : text; _input = text; _focused = false; _chosenText = text; return Task.CompletedTask; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("alcyoneAiInput.resize", _field);
        if (_chosenText is not { } text) return;
        _chosenText = null;
        await JS.InvokeVoidAsync("alcyoneAiInput.setText", _field, text);
    }
    private async Task KeyDown(KeyboardEventArgs e) { var values = Suggestions.ToList(); if (e.Key == "Escape") _focused = false; else if (e.Key == "ArrowDown") { _focused = true; _index = Math.Min(values.Count - 1, _index + 1); } else if (e.Key == "ArrowUp") _index = Math.Max(0, _index - 1); else if (e.Key == "Tab" && _focused && values.Count > 0) await Choose(values[Math.Clamp(_index, 0, values.Count - 1)]); }
    private async Task CopyReply() { try { await JS.InvokeVoidAsync("alcyoneAiInput.copyReply", Reply); } catch (JSException) { } }
    private async Task Send() { if (_busy || CliBusy || string.IsNullOrWhiteSpace(_input)) return; var prompt = _input.Trim(); _input = ""; _focused = false; _busy = true; _hasReply = true; try { await Submit.InvokeAsync(prompt); } finally { _busy = false; } }
}
