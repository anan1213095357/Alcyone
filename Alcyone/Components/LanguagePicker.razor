@inherits LocalizedComponent
@inject IJSRuntime JS

<div class="language-picker">
    <select @key="(L.Language, _error)" aria-label="@L["界面语言"]" title="@L["界面语言"]" value="@L.Language" @onchange="ChangeLanguageAsync" disabled="@_saving">
        <option value="zh-CN">简体中文</option>
        <option value="en">English</option>
    </select>
    @if (_error) { <span class="language-error" role="alert">@L["语言设置保存失败，请重试。"]</span> }
</div>

@code {
    private bool _saving, _error;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("alcyoneLanguage.set", L.Language); }
        catch (JSDisconnectedException) { }
    }
    private async Task ChangeLanguageAsync(ChangeEventArgs args)
    {
        if (args.Value is not string language || !StateMachine.Localization.LanguagePreferences.IsSupported(language)) return;
        _saving = true;
        _error = false;
        try { await L.ChangeAsync(language); }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException) { _error = true; }
        finally { _saving = false; }
    }
}
