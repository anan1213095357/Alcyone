@implements IAsyncDisposable
@inject IJSRuntime JS
@inject StateMachine.Localization.UiText Text
<div class="stream-view @(Busy ? "is-streaming" : "")" @ref="_root">
@if (Progress is not null)
{
    @if (Busy) { <div class="stream-status" role="status"><i></i>@Progress.Status</div> }
    @if (!string.IsNullOrEmpty(Progress.Reasoning))
    {
        <details class="stream-thought"><summary><span>@Text["思考过程"]</span>@if (Busy) { <i class="thought-activity" aria-hidden="true"><b></b><b></b><b></b></i> }</summary><div class="thought-scroll-frame"><pre data-ai-thought-scroll>@Tail(Progress.Reasoning)</pre></div></details>
    }
    @if (Busy && !string.IsNullOrEmpty(Progress.Content)) { <div class="stream-content"><AiMarkdown Text="@Tail(JsonReply ? AiReplyText.FromPartialJson(Progress.Content) : Progress.Content)" /></div> }
}
</div>
@code {
    [Parameter] public AiStreamProgress? Progress { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool JsonReply { get; set; }
    private ElementReference _root;
    private IJSObjectReference? _module;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/AiStreamView.razor.js");
        await _module.InvokeVoidAsync("watch", _root);
    }
    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("unwatch", _root); await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
    private static string Tail(string value) => value.Length > 12000 ? "…\n" + value[^12000..] : value;
}
