                                <span>@L["点击、输入、按键和等待"]</span>
                            </button>

                        </div>

                    </div>
                }
                else
                {
                    <div class="ai-message-list">

                        @foreach (var message in _aiMessages)
                        {
                            <div class="ai-message-row @message.Role">

                                @if (message.Role == "assistant")
                                {
                                    <div class="ai-message-avatar">
                                        ✦
                                    </div>
                                }

                                <div class="ai-message-content">

                                    @if (message.Role == "assistant")
                                    {
                                        <div class="ai-message-name">
                                            AI
                                        </div>
                                    }

                                    <div class="ai-message-bubble">
                                        @message.Text
                                    </div>

                                </div>

                            </div>
                        }

                        @if (_aiBusy)
                        {
                            <div class="ai-message-row assistant">

                                <div class="ai-message-avatar">
                                    ✦
                                </div>

                                <div class="ai-message-content">

                                    <div class="ai-message-name">
                                        AI
                                    </div>

                                    <div class="ai-message-bubble ai-loading">
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>

            <!-- 错误 -->
            @if (!string.IsNullOrWhiteSpace(_aiError))
            {
                <div class="ai-error-bar">
                    <span>!</span>
                    @L[_aiError]
                </div>
            }

            <!-- 待应用变更 -->
            @if (_pendingAiPlan is not null)
            {
                <div class="ai-plan-bar">

                    <div class="ai-plan-icon">
                        ✓
                    </div>

                    <div class="ai-plan-info">
                        <strong>@L["变更已生成"]</strong>

                        @if (_pendingAiPlan.ApplyMachine)
                        {
                            <span>
                                @L.Format("流程：{0} 个状态域 · {1} 个变量 · {2} 个状态 · {3} 条连线", _pendingAiPlan.Regions.Count, _pendingAiPlan.Variables.Count, _pendingAiPlan.States.Count, _pendingAiPlan.Transitions.Count)
                            </span>
                        }
                        else
                        {
                            <span>@L["流程：保持当前状态机不变"]</span>
                        }

                        @if (_pendingAiPlan.Scripts.Count > 0)
                        {
                            <div class="ai-script-list">
                                @foreach (var script in _pendingAiPlan.Scripts)
                                {
                                    <span class="ai-script-chip @(script.Operation == "delete" ? "delete" : "")">
                                        @(script.Operation == "delete" ? L["删除"] : L["写入"]) · @script.FileName
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <button class="btn green"
                            disabled="@(_aiBusy || Runtime.Running || _executing)"
                            @onclick="ApplyPendingAiPlanAsync">
                        @L["应用变更"]
                    </button>

                </div>
            }

            <!-- 输入区 -->
            <div class="ai-composer">

                <div class="ai-composer-box">

                    <textarea class="ai-prompt"
                              @bind="_aiInput"
                              @bind:event="oninput"
                              disabled="@_aiBusy"
                              placeholder="@L["例如：字典识别到“登录”后，点击识别坐标，输入账号并按回车，再等待“完成”出现。"]">
                    </textarea>

                    <div class="ai-composer-footer">

                        <div class="ai-composer-hint">
                            @L["基于当前流程、识别库和已有脚本生成可预览的修改"]
                        </div>

                        <button class="ai-send"
                                disabled="@(_aiBusy || string.IsNullOrWhiteSpace(_aiInput))"
                                @onclick="GenerateAiPlanAsync">

                            @if (_aiBusy)
                            {
                                <span>@L["处理中"]</span>
                            }
                            else
                            {
                                <span>@L["开始发明"]</span>
                                <span class="ai-send-arrow">↑</span>
                            }

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>
}




<script>
    (() => {
        const WORLD_WIDTH = 4000;
        const WORLD_HEIGHT = 2500;
        const MIN_ZOOM = 0.25;
        const MAX_ZOOM = 1.8;

        let dotnet = null;
        let workspace = null;
        let world = null;
        let scaleBox = null;
        let edgeLayer = null;
        let tempEdge = null;
        let canvasZoom = 0.85;
        let edgeState = { edges: [], selectedEdgeId: null, runningEdgeIds: [], pending: null };
        let drag = null;
        let pan = null;
        let suppressClickUntil = 0;
        let initialized = false;

        const clampZoom = value => Math.min(MAX_ZOOM, Math.max(MIN_ZOOM, value));

        function getPortPosition(stateId, portId) {
            const grouped = window.alcyoneGroups?.portPosition(stateId, portId);
            if (grouped) return grouped;
            const element = document.querySelector(`.port[data-state-id="${CSS.escape(stateId)}"][data-port-id="${CSS.escape(portId)}"]`);
            if (!element || !world) return null;
            const rect = element.getBoundingClientRect();
            const worldRect = world.getBoundingClientRect();
            return {
                x: (rect.left - worldRect.left + rect.width / 2) / canvasZoom,
                y: (rect.top - worldRect.top + rect.height / 2) / canvasZoom
            };
        }

        function bezierPath(x1, y1, x2, y2) {
            const distance = Math.max(90, Math.abs(x2 - x1) * 0.45);
            return `M ${x1} ${y1} C ${x1 + distance} ${y1}, ${x2 - distance} ${y2}, ${x2} ${y2}`;
        }

        function drawEdges() {
            if (!edgeLayer) return;
            let html = "";
            const running = new Set(edgeState.runningEdgeIds || []);
            for (const edge of edgeState.edges || []) {
                if (window.alcyoneGroups?.internalEdge(edge)) continue;
                const start = getPortPosition(edge.fromStateId, edge.fromPortId);
                const end = getPortPosition(edge.toStateId, edge.toPortId);
                if (!start || !end) continue;
                const d = bezierPath(start.x, start.y, end.x, end.y);
                const edgeOpacity = window.alcyoneGroups?.edgeOpacity(edge) ?? 1;
                let cls = "edge";
                if (edgeState.selectedEdgeId === edge.id) cls += " selected";
                if (running.has(edge.id)) cls += " running";
                    let stroke = "#64738a";
    let strokeWidth = 2;
    let filter = "";

    if (edgeState.selectedEdgeId === edge.id) {
        stroke = "#4c8dff";
        strokeWidth = 3;
    }

    if (running.has(edge.id)) {
        stroke = "#2bd59a";
        strokeWidth = 3;
        filter = "filter:drop-shadow(0 0 5px rgba(43,213,154,.8));";
    }

    html += `
    <path
        class="${cls}"
        d="${d}"
        fill="none"
        stroke="${stroke}"
        stroke-width="${strokeWidth}"
        style="${filter}opacity:${edgeOpacity}">
    </path>`;

    html += `
    <path
        class="edge-hit"
        data-edge-id="${edge.id}"
        d="${d}"
        fill="none"
        stroke="transparent"
        stroke-width="16"
        style="pointer-events:${edgeOpacity < .5 ? 'none' : 'stroke'};cursor:pointer;">
    </path>`;
                const delay = Math.max(0, Number(edge.delayMilliseconds) || 0);
                if (delay > 0) {
                    const waitLabel = document.documentElement.lang === "en" ? "Wait" : "等待";
                    const label = delay >= 1000 ? `${waitLabel} ${+(delay / 1000).toFixed(3)} s` : `${waitLabel} ${delay} ms`;
                    const curve = document.createElementNS("http://www.w3.org/2000/svg", "path");
                    curve.setAttribute("d", d);
                    const length = curve.getTotalLength();
                    const span = Math.min(length, Math.max(100, label.length * 9 + 28));
                    const from = (length - span) / 2, to = (length + span) / 2;
                    const points = [];
                    for (let t = from; t < to; t += 2) points.push(curve.getPointAtLength(t));
                    points.push(curve.getPointAtLength(to));
                    // Reverse the same sampled curve to keep lettering readable on return wires.
                    if (points[0].x > points[points.length - 1].x) points.reverse();
                    const sleeve = points.map((p, i) => `${i ? "L" : "M"} ${p.x} ${p.y}`).join(" ");
                    const pathId = `delay-sleeve-${(edgeState.edges || []).indexOf(edge)}`;
                    html += `<g data-edge-id="${edge.id}" style="opacity:${edgeOpacity};cursor:pointer;pointer-events:${edgeOpacity < .5 ? 'none' : 'all'}">
                        <title>${document.documentElement.lang === "en" ? "Click to set the transition delay" : "点击设置切换前等待"}</title>
                        <path d="${sleeve}" fill="none" stroke="${stroke}" stroke-width="27" stroke-linecap="round" />
                        <path id="${pathId}" d="${sleeve}" fill="none" stroke="#182438" stroke-width="23" stroke-linecap="round" />
                        <text fill="#e4efff" font-size="11" font-weight="600" dy="4" text-anchor="middle" style="pointer-events:all"><textPath href="#${pathId}" startOffset="50%">${label}</textPath></text>
                    </g>`;
                }
            }
            edgeLayer.innerHTML = html;
        }

        function updatePendingVisual() {
            document.querySelectorAll(".port.pending").forEach(x => x.classList.remove("pending"));
            if (!tempEdge) return;
            const pending = edgeState.pending;
            if (!pending) {
                tempEdge.style.display = "none";
                return;
            }
            const port = document.querySelector(`.port[data-state-id="${CSS.escape(pending.stateId)}"][data-port-id="${CSS.escape(pending.portId)}"]`);
            if (port) port.classList.add("pending");
            tempEdge.style.display = "block";
        }

        function updateTempEdge(clientX, clientY) {
            const pending = edgeState.pending;
            if (!pending || !tempEdge || !world) return;
            const start = getPortPosition(pending.stateId, pending.portId);
            if (!start) return;
            const rect = world.getBoundingClientRect();
            const x = (clientX - rect.left) / canvasZoom;
            const y = (clientY - rect.top) / canvasZoom;
            tempEdge.setAttribute("d", bezierPath(start.x, start.y, x, y));
        }

        function setZoom(value, keepCenter = false) {
            if (!workspace || !world || !scaleBox) return;
            const oldZoom = canvasZoom;
            let centerWorldX = 0;
            let centerWorldY = 0;
            if (keepCenter) {
                centerWorldX = (workspace.scrollLeft + workspace.clientWidth / 2) / oldZoom;
                centerWorldY = (workspace.scrollTop + workspace.clientHeight / 2) / oldZoom;
            }
            canvasZoom = clampZoom(Number(value));
            world.style.transform = `scale(${canvasZoom})`;
            scaleBox.style.width = `${WORLD_WIDTH * canvasZoom}px`;
            scaleBox.style.height = `${WORLD_HEIGHT * canvasZoom}px`;
            const label = document.getElementById("zoomLabel");
            if (label) label.textContent = `${Math.round(canvasZoom * 100)}%`;
            if (keepCenter) {
                workspace.scrollLeft = centerWorldX * canvasZoom - workspace.clientWidth / 2;
                workspace.scrollTop = centerWorldY * canvasZoom - workspace.clientHeight / 2;
            }
            requestAnimationFrame(drawEdges);
        }

        function fitCanvas() {
            if (!workspace) return;
            const cards = [...document.querySelectorAll(".state-card:not([hidden]), .alcyone-orb")];
            if (cards.length === 0) {
                setZoom(0.85, false);
                workspace.scrollLeft = 0;
                workspace.scrollTop = 0;
                return;
            }
            let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
            for (const card of cards) {
                const x = parseFloat(card.style.left) || 0;
                const y = parseFloat(card.style.top) || 0;
                const width = card.offsetWidth || 540;
                const height = card.offsetHeight || 220;
                minX = Math.min(minX, x);
                minY = Math.min(minY, y);
                maxX = Math.max(maxX, x + width);
                maxY = Math.max(maxY, y + height);
            }
            const padding = 120;
            const width = maxX - minX + padding * 2;
            const height = maxY - minY + padding * 2;
            const zoom = clampZoom(Math.min(workspace.clientWidth / width, workspace.clientHeight / height, 1));
            setZoom(zoom, false);
            workspace.scrollLeft = Math.max(0, (minX - padding) * zoom);
            workspace.scrollTop = Math.max(0, (minY - padding) * zoom);
        }

        function isBackground(target) {
            return target === workspace || target?.id === "world" || target?.id === "stateLayer" || target?.id === "edgeSvg";
        }

        function onPointerDown(event) {
            if (!workspace) return;
            if (window.alcyoneGroups?.pointerDown(event)) return;
            const header = event.target.closest?.(".state-header");
            if (header && event.button === 0) {
                const card = header.closest(".state-card");
                if (!card) return;
                drag = {
                    stateId: card.dataset.stateId,
                    card,
                    mouseX: event.clientX,
                    mouseY: event.clientY,
                    startX: parseFloat(card.style.left) || 0,
                    startY: parseFloat(card.style.top) || 0,
                    x: parseFloat(card.style.left) || 0,
                    y: parseFloat(card.style.top) || 0,
                    moved: false
                };
                event.preventDefault();
                return;
            }

            if (event.button === 1 || event.button === 2) {
                pan = {
                    mouseX: event.clientX,
                    mouseY: event.clientY,
                    scrollLeft: workspace.scrollLeft,
                    scrollTop: workspace.scrollTop,
                    moved: false
                };
                workspace.style.cursor = "grabbing";
                event.preventDefault();
            }
        }

        function onPointerMove(event) {
            if (window.alcyoneGroups?.pointerMove(event)) return;
            if (pan && workspace) {
                const dx = event.clientX - pan.mouseX;
                const dy = event.clientY - pan.mouseY;
                if (Math.abs(dx) + Math.abs(dy) > 3) pan.moved = true;
                workspace.scrollLeft = pan.scrollLeft - dx;
                workspace.scrollTop = pan.scrollTop - dy;
            }
            if (drag) {
                const dx = (event.clientX - drag.mouseX) / canvasZoom;
                const dy = (event.clientY - drag.mouseY) / canvasZoom;
                drag.x = Math.max(0, drag.startX + dx);
                drag.y = Math.max(0, drag.startY + dy);
                if (Math.abs(dx) + Math.abs(dy) > 1) drag.moved = true;
                if (drag.card?.isConnected) {
                    drag.card.style.left = `${drag.x}px`;
                    drag.card.style.top = `${drag.y}px`;
                }
                drawEdges();
            }
            updateTempEdge(event.clientX, event.clientY);
        }

        function onPointerUp(event) {
            if (window.alcyoneGroups?.pointerUp(event)) { suppressClickUntil = Date.now() + 180; return; }
            if (pan) {
                if (pan.moved) suppressClickUntil = Date.now() + 150;
                pan = null;
                if (workspace) workspace.style.cursor = "";
            }
            if (drag) {
                const finished = drag;
                drag = null;
                if (finished.moved) {
                    suppressClickUntil = Date.now() + 150;
                    dotnet?.invokeMethodAsync("StateMoved", finished.stateId, finished.x, finished.y);
                }
            }
        }

        function onClick(event) {
            if (Date.now() < suppressClickUntil) return;
            if (window.alcyoneGroups?.click(event)) return;
            const edge = event.target.closest?.("[data-edge-id]");
            if (edge?.dataset.edgeId) {
                event.stopPropagation();
                dotnet?.invokeMethodAsync("SelectEdgeFromJs", edge.dataset.edgeId);
                return;
            }
            if (event.target.closest?.(".port,.add-port,button,input,select,textarea,label")) return;
            const card = event.target.closest?.(".state-card");
            if (card?.dataset.stateId) {
                dotnet?.invokeMethodAsync("SelectStateFromJs", card.dataset.stateId);
                return;
            }
            if (isBackground(event.target)) dotnet?.invokeMethodAsync("ClearSelectionFromJs");
        }

        function onCanvasContextMenu(event) { event.preventDefault(); }

        function onWheel(event) {
            if (!workspace || (!event.ctrlKey && !event.metaKey)) return;
            event.preventDefault();
            const rect = workspace.getBoundingClientRect();
            const mouseX = event.clientX - rect.left;
            const mouseY = event.clientY - rect.top;
            const worldX = (workspace.scrollLeft + mouseX) / canvasZoom;
            const worldY = (workspace.scrollTop + mouseY) / canvasZoom;
            const factor = event.deltaY < 0 ? 1.1 : 0.9;
            const newZoom = clampZoom(canvasZoom * factor);
            setZoom(newZoom, false);
            workspace.scrollLeft = worldX * newZoom - mouseX;
            workspace.scrollTop = worldY * newZoom - mouseY;
        }

        function onKeyDown(event) {
            const tag = document.activeElement?.tagName;
            if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT") return;
            if (window.alcyoneGroups?.keyDown(event)) return;
            if (event.key === "Delete") dotnet?.invokeMethodAsync("DeleteSelectionFromJs");
            if (event.key === "Escape") dotnet?.invokeMethodAsync("EscapeFromJs");
        }

        let stopStarfield = null;
        function startStarfield() {
            stopStarfield?.();
            const canvas = document.getElementById("workspaceStarfield");
            if (!canvas || !workspace) return;
            const ctx = canvas.getContext("2d", { alpha: false });
            if (!ctx) return;
            const host = workspace;
            const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
            let width = 1, height = 1, stars = [], frame = 0, last = 0, stopped = false;
            function spawn(randomDepth) {
                const angle = Math.random() * Math.PI * 2;
                const radius = .08 + Math.sqrt(Math.random()) * 1.3;
                return { x: Math.cos(angle) * radius, y: Math.sin(angle) * radius,
                    z: randomDepth ? .12 + Math.random() * .88 : 1,
                    size: .35 + Math.random() * .85, blue: Math.random() < .2 };
            }
            function resize() {
                width = Math.max(1, host.clientWidth); height = Math.max(1, host.clientHeight);
                const ratio = Math.min(window.devicePixelRatio || 1, 2);
                canvas.width = Math.round(width * ratio); canvas.height = Math.round(height * ratio);
                canvas.style.width = width + "px"; canvas.style.height = height + "px";
                ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
                stars = Array.from({ length: Math.min(650, Math.max(140, Math.round(width * height / 2200))) }, () => spawn(true));
                paint(0);
            }
            function paint(dt) {
                ctx.fillStyle = "#010205"; ctx.fillRect(0, 0, width, height);
                const cx = width * .5, cy = height * .46, scale = Math.max(width, height) * .5;
                for (let i = 0; i < stars.length; i++) {
                    let star = stars[i];
                    const previous = star.z;
                    star.z -= dt * .095;
                    let x = cx + star.x * scale / star.z, y = cy + star.y * scale / star.z;
                    if (star.z < .075 || x < -30 || x > width + 30 || y < -30 || y > height + 30) {
                        stars[i] = spawn(false); continue;
                    }
                    const depth = 1 - star.z;
                    const alpha = .22 + depth * .57;
                    ctx.strokeStyle = star.blue ? `rgba(166,203,255,${alpha})` : `rgba(228,237,255,${alpha})`;
                    ctx.fillStyle = ctx.strokeStyle;
                    const radius = star.size * (.45 + depth * 1.25);
                    if (dt > 0 && depth > .35) {
                        const tailZ = star.z + Math.max(previous - star.z, .006) * 2.2;
                        ctx.lineWidth = Math.max(.5, radius * .85);
                        ctx.beginPath(); ctx.moveTo(cx + star.x * scale / tailZ, cy + star.y * scale / tailZ); ctx.lineTo(x, y); ctx.stroke();
                    }
                    ctx.beginPath(); ctx.arc(x, y, radius, 0, Math.PI * 2); ctx.fill();
                }
            }
            function tick(time) {
                if (stopped) return;
                const dt = last ? Math.min((time - last) / 1000, .05) : 0; last = time;
                paint(dt); frame = requestAnimationFrame(tick);
            }
            function resume() {
                cancelAnimationFrame(frame); last = 0;
                if (!document.hidden && !reduced.matches) frame = requestAnimationFrame(tick);
                else paint(0);
            }
            const observer = new ResizeObserver(resize); observer.observe(host);
            document.addEventListener("visibilitychange", resume);
            reduced.addEventListener("change", resume);
            resize(); resume();
            stopStarfield = () => {
                stopped = true; cancelAnimationFrame(frame); observer.disconnect();
                document.removeEventListener("visibilitychange", resume); reduced.removeEventListener("change", resume);
            };
        }

        window.industrialStateMachineUi = {
            init(dotnetRef) {
                dotnet = dotnetRef;
                workspace = document.getElementById("workspace");
                world = document.getElementById("world");
                scaleBox = document.getElementById("worldScale");
                edgeLayer = document.getElementById("edgeLayer");
                tempEdge = document.getElementById("tempEdge");
                if (initialized) return;
                initialized = true;
                window.alcyoneGroups?.init({ workspace, world, dotnet, drawEdges, zoom: () => canvasZoom });
                startStarfield();
                workspace?.addEventListener("pointerdown", onPointerDown);
                workspace?.addEventListener("contextmenu", onCanvasContextMenu);
                workspace?.addEventListener("click", onClick);
                workspace?.addEventListener("wheel", onWheel, { passive: false });
                workspace?.addEventListener("scroll", drawEdges);
                window.addEventListener("pointermove", onPointerMove);
                window.addEventListener("pointerup", onPointerUp);
                window.addEventListener("keydown", onKeyDown);
                window.addEventListener("resize", drawEdges);
            },
            dispose() {
                if (!initialized) return;
                window.alcyoneGroups?.dispose();
                stopStarfield?.(); stopStarfield = null;
                workspace?.removeEventListener("pointerdown", onPointerDown);
                workspace?.removeEventListener("contextmenu", onCanvasContextMenu);
                workspace?.removeEventListener("click", onClick);
                workspace?.removeEventListener("wheel", onWheel);
                workspace?.removeEventListener("scroll", drawEdges);
                window.removeEventListener("pointermove", onPointerMove);
                window.removeEventListener("pointerup", onPointerUp);
                window.removeEventListener("keydown", onKeyDown);
                window.removeEventListener("resize", drawEdges);
                initialized = false;
                dotnet = null;
            },
            sync(state) {
                edgeState = state || edgeState;
                window.alcyoneGroups?.sync(state);
                if (state?.language) window.alcyoneLanguage.set(state.language);
                updatePendingVisual();
                requestAnimationFrame(drawEdges);
            },
            setZoom(value, keepCenter) { setZoom(value, !!keepCenter); },
            adjustZoom(delta, keepCenter) { setZoom(canvasZoom + Number(delta), !!keepCenter); },
            fitCanvas,
            getAddStatePosition() {
                if (!workspace) return { x: 280, y: 140 };
                return {
                    x: (workspace.scrollLeft + 280) / canvasZoom,
                    y: (workspace.scrollTop + 140) / canvasZoom
                };
            },
            setInitialScroll(left, top) {
                if (!workspace) return;
                workspace.scrollLeft = Number(left) || 0;
                workspace.scrollTop = Number(top) || 0;
            },
            scrollConsoleToBottom() {
                const box = document.getElementById("console");
                if (box) box.scrollTop = box.scrollHeight;
            },
            downloadText(filename, text, mime) {
                const blob = new Blob([text], { type: mime || "text/plain" });
                const url = URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = url;
                a.download = filename;
                a.click();
                URL.revokeObjectURL(url);
            },
            storage: {
                list(prefix) {
                    const keys = [];
                    for (let i = 0; i < localStorage.length; i++) {
                        const key = localStorage.key(i);
                        if (key && key.startsWith(prefix)) keys.push(key.substring(prefix.length));
                    }
                    return keys.sort((a, b) => a.localeCompare(b, "zh-CN"));
                },
                set(key, value) { localStorage.setItem(key, value); },
                get(key) { return localStorage.getItem(key); },
                remove(key) { localStorage.removeItem(key); }
            }
        };
    })();
</script>@if (_recognitionManagerOpen)
{
    <RecognitionManager Items="Machine.Recognitions" SelectedId="_recognitionSelection" OnClose="() => _recognitionManagerOpen = false" OnChanged="RecognitionLibraryChanged" OnTest="TestRecognitionAsync" Status="RecognitionStatus" Busy="_executing" />
}
