                <div class="ai-header-left">
                    <div class="ai-logo">✦</div>

                    <div>
                        <div class="ai-title">@L["AI 脚本助手"]</div>
                        <div class="ai-subtitle">
                            @L["围绕当前色库和字典，编排识别条件与键鼠动作"]
                        </div>
                    </div>
                </div>

                <div class="ai-header-actions">

                    <div class="ai-model-badge">
                        <span class="ai-model-dot"></span>
                        @_configKey
                    </div>

                    @if (_aiMessages.Count > 0)
                    {
                        <button class="ai-toolbar-btn"
                                @onclick="ClearAiConversation"
                                title="@L["清空对话"]">
                            @L["清空对话"]
