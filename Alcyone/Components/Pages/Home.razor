@inherits LocalizedComponent
@page "/"
@using System.Globalization
@using System.IO
@using System.Linq
@using System.Collections.Generic
@using System.Text
@using System.Text.Json
@using System.Text.Json.Nodes
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable
@rendermode InteractiveServer

<div id="app">
    <div class="topbar">
        <div class="logo">
            <div class="logo-icon"><img src="images/state-machine-logo.png" alt="Alcyone" /></div>
            Alcyone
        </div>
        <div class="toolbar-group edit-tools">
            <button class="btn add-state-control" @onclick="AddStateAsync"><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="3" width="14" height="14" rx="3"/><path d="M10 6v8 M6 10h8"/></svg><span>@L["添加状态"]</span></button>
            <button class="btn ai-development-control" @onclick="OpenAiDialog"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m10 2 2.2 5.8L18 10l-5.8 2.2L10 18l-2.2-5.8L2 10l5.8-2.2z"/></svg><span>@L["AI 开发"]</span></button>
        </div>
        <div class="toolbar-group view-tools">
            <button class="btn quiet icon-control" title="@L["缩小"]" aria-label="@L["缩小"]" @onclick="ZoomOutAsync">−</button>
            <div id="zoomLabel" class="zoom-label">85%</div>
            <button class="btn quiet icon-control" title="@L["放大"]" aria-label="@L["放大"]" @onclick="ZoomInAsync">+</button>
            <button class="btn quiet" @onclick="FitCanvasAsync">@L["适配"]</button>
            <span class="canvas-gesture-hint">@L["左键框选 · 右键平移"]</span>
            <button id="collapseSelectionButton" class="btn quiet" type="button" disabled>@L["收纳为 Alcyone"]</button>
        </div>
        <div class="spacer"></div>
        <div class="execution-controls" role="group" aria-label="@L["运行控制"]">
            <span class="execution-status @RuntimeStatusClass"><i></i>@L[RuntimeStatusText]</span>
            <div class="execution-buttons">
                <button class="execution-button run @(Runtime.Running || _startingRuntime ? "is-active" : "")" disabled="@RuntimeControlsBusy" aria-label="@L["运行"]" title="@L["连续运行"]" @onclick="RunMachineAsync">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 4 10 6-10 6z" /></svg><span class="control-label">@L["运行"]</span>
                </button>
                <button class="execution-button step @(_steppingRuntime ? "is-active" : "")" disabled="@RuntimeControlsBusy" aria-label="@L["单步"]" title="@L["执行一个周期"]" @onclick="StepAsync">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 5 8 5-8 5z M15 5v10" /></svg><span class="control-label">@L["单步"]</span>
                </button>
                <button class="execution-button stop @(CanStopRuntime ? "is-available" : "")" disabled="@(!CanStopRuntime)" aria-label="@L["停止"]" title="@L["停止当前执行"]" @onclick="StopRuntime">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="5" y="5" width="10" height="10" rx="1.5" /></svg><span class="control-label">@L["停止"]</span>
                </button>
                <button class="execution-button reset @(_resettingRuntime ? "is-active" : "")" disabled="@RuntimeControlsBusy" aria-label="@L["重置"]" title="@L["恢复初始状态和变量"]" @onclick="ResetRuntime">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 8a6 6 0 1 1 0 5 M4 3v5h5" /></svg><span class="control-label">@L["重置"]</span>
                </button>
            </div>
        </div>
        <LanguagePicker />
        <div class="config-control">
            <button class="config-trigger @(_configMenuOpen ? "is-open" : "")" aria-label="@L["选择配置"]" aria-expanded="@_configMenuOpen" @onclick="() => _configMenuOpen = !_configMenuOpen">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 2.5h7l3 3v12H5z M12 2.5v4h3 M8 10h4 M8 13h4" /></svg>
                <span>@_configKey</span><span class="config-chevron">⌄</span>
            </button>
            @if (_configMenuOpen)
            {
                <div class="config-dismiss" @onclick="() => _configMenuOpen = false"></div>
                <section class="config-menu" aria-label="@L["配置管理"]">
                    <div class="config-menu-title">@L["切换配置"]</div>
                    <div class="config-options">
                        @foreach (var key in _configKeys)
                        {
                            <button class="config-option @(key == _configKey ? "active" : "")" @onclick="async () => { await SwitchConfigAsync(key); _configMenuOpen = false; }"><span>@key</span><span>@(key == _configKey ? "✓" : "")</span></button>
                        }
                        @if (_configKeys.Count == 0) { <div class="config-empty">@L["暂无配置"]</div> }
                    </div>
                    <div class="config-create">
                        <input placeholder="@L["新配置名称"]" aria-label="@L["新配置名称"]" @bind="_newConfigKey" @bind:event="oninput" />
                        <button class="btn primary" disabled="@string.IsNullOrWhiteSpace(_newConfigKey)" @onclick="async () => { await CreateConfigAsync(); _configMenuOpen = false; }">@L["新建"]</button>
                    </div>
                    <div class="config-menu-actions">
                        <label for="importFile" class="config-action">@L["导入配置"]</label>
                        <button class="config-action" @onclick="async () => { await ExportConfigAsync(); _configMenuOpen = false; }">@L["导出配置"]</button>
                        <button class="config-action danger" @onclick="async () => { await DeleteConfigAsync(); _configMenuOpen = false; }">@L["删除当前配置"]</button>
                    </div>
                </section>
            }
            <InputFile id="importFile" OnChange="ImportConfigAsync" accept=".json,application/json" style="display:none" />
        </div>
    </div>

    <div class="main">
        <aside class="left-panel">
            <div class="section">
                <div class="section-head">
                    <div class="section-title">@L["并行状态域"]</div>
                    <button class="btn small" @onclick="AddRegion">@L["+ 状态域"]</button>
                </div>
                <div id="regionList">
                    @foreach (var region in Machine.Regions)
                    {
                        var currentState = GetCurrentState(region.Id);
                        <div class="region-card @(SelectedRegionId == region.Id ? "selected" : "")" @onclick="() => SelectRegion(region.Id)">
                            <div class="region-line">
                                <div class="region-color"></div>
                                <input class="region-name region-name-input"
                                       value="@region.Name"
                                       @oninput="e => RenameRegion(region.Id, e.Value?.ToString() ?? string.Empty)"
                                       @onclick:stopPropagation="true" />
                                <button class="remove-btn delete-region" style="width:25px;height:25px" @onclick="() => DeleteRegion(region.Id)" @onclick:stopPropagation="true">×</button>
                            </div>
                            <div class="region-current">Current：<strong>@(currentState?.Name ?? "-")</strong></div>
                        </div>
                    }
                </div>
                <div class="hint">@L["每个状态域独立拥有自己的 Current State。"]<br />@L["多个状态域可以同时运行。"]</div>
            </div>

            <div class="section">
                <div class="section-head">
                    <div class="section-title">@L["全局变量"]</div>
                    <button class="btn small" @onclick="AddVariable">@L["+ 变量"]</button>
                </div>
                <div id="variableList">
                    @foreach (var variable in Machine.Variables)
                    {
                        <div class="variable-card" @key="variable.Id">
                            <div class="variable-top">
                                <input class="input" value="@variable.Name" @oninput="e => RenameVariable(variable.Id, e.Value?.ToString() ?? string.Empty)" />
                                <button class="remove-btn" @onclick="() => DeleteVariable(variable.Id)">×</button>
                            </div>
                            <div class="variable-bottom">
                                <select class="select" value="@variable.Type" @onchange='e => ChangeVariableType(variable.Id, e.Value?.ToString() ?? "number")'>
                                    <option value="number">@L["数值"]</option><option value="boolean">@L["布尔"]</option><option value="string">@L["文本"]</option><option value="json">JSON</option>
                                </select>
                                @if (variable.Type == "boolean")
                                {
                                    <select class="select" value="@DisplayNode(variable.Value, variable.Type)" @onchange='e => ChangeVariableValue(variable.Id, e.Value?.ToString() ?? "false")'>
                                        <option value="true">true</option><option value="false">false</option>
                                    </select>
                                }
                                else
                                {
                                    <input class="input" value="@DisplayNode(variable.Value, variable.Type)" @onchange="e => ChangeVariableValue(variable.Id, e.Value?.ToString() ?? string.Empty)" />
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="section">
                <div class="section-head">
                    <div class="section-title">@L["识别库"] <span class="hint">@Machine.Recognitions.Count(i => i.ParentId is null)</span></div>
                    <button class="btn small" @onclick="() => OpenRecognitionManager()">@L["管理 / 导入"]</button>
                </div>
                @foreach (var item in Machine.Recognitions.Where(i => i.ParentId is null))
                {
                    <button class="recognition-summary" @key="item.Id" @onclick="() => OpenRecognitionManager(item.Id)">
                        <span><strong>@item.Name</strong><small>@L[StateMachine.Automation.RecognitionItem.KindName(item.Settings.Mode)]</small></span>
                    </button>
                }
                @if (Machine.Recognitions.Count == 0)
                {
                    <div class="hint">@L["导入字典或多点颜色，在出口条件中选择识别项目。"]</div>
                }
            </div>

        </aside>

        <main id="workspace" class="workspace">
            <div class="starfield-anchor" aria-hidden="true"><canvas id="workspaceStarfield"></canvas></div>
            <div id="worldScale">
                <div id="world">
                    <div id="alcyoneGroupLayer"></div>
                    <svg id="edgeSvg">
                        <g id="edgeLayer"></g>
                        <path id="tempEdge"></path>
                    </svg>
                    <div id="stateLayer">
                        @foreach (var state in Machine.States)
                        {
                            var region = GetRegion(state.RegionId);
                            var current = Runtime.CurrentStates.TryGetValue(state.RegionId, out var currentId) && currentId == state.Id;
                            <div class="state-card @(SelectedStateId == state.Id ? "selected" : "") @(current ? "current" : "")"
                                 data-state-id="@state.Id"
                                 style="left:@(state.X.ToString(CultureInfo.InvariantCulture))px;top:@(state.Y.ToString(CultureInfo.InvariantCulture))px"
                                 @key="state.Id">
                                <div class="state-header">
                                    @if (state.IsStart)
                                    {
                                        <span class="badge start-badge">START</span>
                                    }
                                    @if (current)
                                    {
                                        <span class="badge current-badge">CURRENT</span>
                                    }
                                    <span class="badge region-badge">@(region?.Name ?? "")</span>
                                    <div class="state-name">@state.Name</div>
                                </div>

                                <div class="state-content">
                                    <div class="port-zone left">
                                        @foreach (var input in state.Inputs)
                                        {
                                            var connected = GetEdgeToPort(state.Id, input.Id) is not null;
                                            <div class="port-item left" @key="input.Id">
                                                <div class="port input-port @(connected ? "connected" : "")"
                                                     data-direction="input"
                                                     data-state-id="@state.Id"
                                                     data-port-id="@input.Id"
                                                     @onclick="() => OnInputPortClickAsync(state.Id, input.Id)"
                                                     @onclick:stopPropagation="true"></div>
                                                <div class="port-label">@input.Name</div>
                                            </div>
                                        }
                                        <div class="port-item left">
                                            <button class="add-port" @onclick="() => QuickAddInput(state.Id)" @onclick:stopPropagation="true">+</button>
                                        </div>
                                    </div>

                                    <div class="state-center">
                                        <div class="center-title">@L["出口条件 · 从上往下按优先级判断"]</div>
                                        @if (state.Outputs.Count == 0)
                                        {
                                            <div class="empty-center">@L["当前没有切换出口"]</div>
                                        }
                                        else
                                        {
                                            @for (var outputIndex = 0; outputIndex < state.Outputs.Count; outputIndex++)
                                            {
                                                var output = state.Outputs[outputIndex];
                                                var edge = GetEdgeFromPort(state.Id, output.Id);
                                                var detail = GetConditionResult(state.Id, output.Id);
                                                var hasRuntimeResult = current && detail is not null;
                                                bool? matched = hasRuntimeResult ? detail!.Matched : null;
                                                var summaryClass = edge is null ? "unconnected" : matched == true ? "matched" : matched == false ? "failed" : "";
                                                var iconClass = edge is null ? "unconnected" : matched == true ? "ok" : matched == false ? "no" : "idle";
                                                var icon = edge is null ? "!" : matched == true ? "✓" : matched == false ? "×" : "·";
                                                <div class="transition-summary @summaryClass" @key="output.Id">
                                                    <div class="transition-summary-head">
                                                        <div class="transition-priority">@(outputIndex + 1)</div>
                                                        <div class="transition-name" title="@output.Name">@output.Name</div>
                                                        <div class="mode-chip @output.MatchMode">@output.MatchMode.ToUpperInvariant()</div>
                                                        <div class="transition-state-icon @iconClass">@icon</div>
                                                    </div>
                                                    <div class="condition-mini-list">
                                                        @if (output.MatchMode == "always")
                                                        {
                                                            <div class="always-condition"><span>⚡</span><span>@L["无条件切换"]</span></div>
                                                        }
                                                        else if (output.Conditions.Count == 0)
                                                        {
                                                            <div class="always-condition">@L["没有配置条件"]</div>
                                                        }
                                                        else
                                                        {
                                                            @foreach (var condition in output.Conditions)
                                                            {
                                                                bool? conditionResult = null;
                                                                if (hasRuntimeResult && detail!.Conditions.TryGetValue(condition.Id, out var cr))
                                                                    conditionResult = cr;
                                                                var rowClass = conditionResult == true ? "condition-ok" : conditionResult == false ? "condition-no" : "";
                                                                var cIconClass = conditionResult == true ? "ok" : conditionResult == false ? "no" : "idle";
                                                                var cIcon = conditionResult == true ? "✓" : conditionResult == false ? "×" : "·";
                                                                var rightVariable = condition.RightMode == "variable";
                                                                var rightText = rightVariable ? "$" + NodeString(condition.RightValue) : DisplayNode(condition.RightValue, condition.RightType);
                                                                <div class="condition-mini @rowClass" @key="condition.Id">
                                                                    @if (condition.Kind == "recognition")
                                                                    {
                                                                        <span class="expr-chip variable" title="@RecognitionConditionText(condition)">@RecognitionConditionText(condition)</span>
                                                                    }
                                                                    else
                                                                    {
                                                                    <span class="expr-chip variable" title="@condition.Left">@condition.Left</span>
                                                                    <span class="operator-chip">@condition.Operator</span>
                                                                    <span class="expr-chip @(rightVariable ? "other-variable" : "value")" title="@rightText">@rightText</span>
                                                                    }
                                                                    <span class="condition-spacer"></span>
                                                                    <span class="condition-result-icon @cIconClass">@cIcon</span>
                                                                </div>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>

                                    <div class="port-zone right">
                                        @foreach (var output in state.Outputs)
                                        {
                                            var connected = GetEdgeFromPort(state.Id, output.Id) is not null;
                                            var pending = PendingConnection is not null && PendingConnection.StateId == state.Id && PendingConnection.PortId == output.Id;
                                            <div class="port-item right" @key="output.Id">
                                                <div class="port-label">@output.Name</div>
                                                <div class="port output-port @(connected ? "connected" : "") @(pending ? "pending" : "")"
                                                     data-direction="output"
                                                     data-state-id="@state.Id"
                                                     data-port-id="@output.Id"
                                                     @onclick="() => OnOutputPortClickAsync(state.Id, output.Id)"
                                                     @onclick:stopPropagation="true"></div>
                                            </div>
                                        }
                                        <div class="port-item right">
                                            <button class="add-port" @onclick="() => QuickAddOutput(state.Id)" @onclick:stopPropagation="true">+</button>
                                        </div>
                                    </div>
                                </div>

                                <div class="state-footer">
                                    @L.Format("输入：{0}　输出：{1}", state.Inputs.Count, state.Outputs.Count)
                                    <div class="spacer"></div>
                                    @(current ? L["实时判断中"] : L["非当前状态"])
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </main>

        <aside class="right-panel">
            <div class="inspector">
                <div class="section-title">@L["属性"]</div>
                <div id="inspectorContent">
                    @if (!string.IsNullOrWhiteSpace(SelectedEdgeId))
                    {
                        var edge = Machine.Edges.FirstOrDefault(x => x.Id == SelectedEdgeId);
                        if (edge is not null)
                        {
                            var from = GetState(edge.FromStateId);
                            var to = GetState(edge.ToStateId);
                            var output = from?.Outputs.FirstOrDefault(x => x.Id == edge.FromPortId);
                            var input = to?.Inputs.FirstOrDefault(x => x.Id == edge.ToPortId);
                            <div class="group">
                                <div class="group-title">@L["状态连线"]</div>
                                <div style="margin-top:9px;color:#9faabe;font-size:10px;line-height:1.8">
                                    @(from?.Name ?? "")<br />
                                    @(output?.Name ?? "")<br />
                                    ↓<br />
                                    @(to?.Name ?? "")<br />
                                    @(input?.Name ?? "")
                                </div>
                            </div>
                            <div class="group">
                                <div class="group-title">@L["切换前等待"]</div>
                                <label>@L["等待时间（毫秒）"]</label>
                                <input type="number" min="0" max="86400000" step="100" value="@edge.DelayMilliseconds" @onchange="e => ChangeEdgeDelayAsync(edge, e)" />
                                <div style="margin-top:8px;color:#9faabe;font-size:11px;line-height:1.7">@L["条件满足后，等待结束再切换。0 表示不额外等待。"]</div>
                            </div>
                            <button class="danger" @onclick="DeleteSelectedEdge">@L["删除连线"]</button>
                        }
                    }
                    else if (SelectedState is null)
                    {
                        <div class="empty-inspector">
                            @L["点击状态卡片编辑。"]<br /><br />
                            @L["每个右侧切换插头拥有自己的条件组。"]<br /><br />
                            @L["ALL：所有条件全部成立。"]<br /><br />
                            @L["ANY：任意一个条件成立。"]<br /><br />
                            @L["当前状态卡中，每个小条件都会实时显示 ✓ 或 ×。"]<br /><br />
                            @L["多个出口同时满足时，从上往下只执行第一个。"]<br /><br />
                            @L["Ctrl + 鼠标滚轮：缩放画布。"]
                        </div>
                    }
                    else
                    {
                        var state = SelectedState!;
                        <div class="field">
                            <label class="field-label">@L["状态名称"]</label>
                            <input class="input" value="@state.Name" @oninput="e => RenameState(state.Id, e.Value?.ToString() ?? string.Empty)" />
                        </div>
                        <div class="field">
                            <label class="field-label">@L["所属状态域"]</label>
                            <select class="select" value="@state.RegionId" @onchange="e => ChangeStateRegion(state.Id, e.Value?.ToString() ?? string.Empty)">
                                @foreach (var region in Machine.Regions)
                                {
                                    <option value="@region.Id">@region.Name</option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label style="display:flex;gap:7px;align-items:center;color:#adb8c9;font-size:10px">
                                <input type="checkbox" checked="@state.IsStart" @onchange="e => ChangeStateStart(state.Id, e.Value is bool b && b)" />
                                @L["当前状态域的初始状态"]
                            </label>
                        </div>

                        <div class="group">
                            <div class="group-header">
                                <div class="group-title">@L["进入插头"]</div>
                                <button class="btn small" @onclick="() => AddInput(state.Id)">@L["+ 插头"]</button>
                            </div>
                            @foreach (var input in state.Inputs)
                            {
                                <div class="port-editor" @key="input.Id">
                                    <div class="port-editor-row">
                                        <input class="input" value="@input.Name" @oninput="e => RenameInput(state.Id, input.Id, e.Value?.ToString() ?? string.Empty)" />
                                        <button class="remove-btn" @onclick="() => RemoveInput(state.Id, input.Id)">×</button>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="group">
                            <div class="group-title">@L["状态生命周期"]</div>
                            <div class="hint">@L["进入脚本执行一次；循环脚本每个扫描周期执行；离开脚本在转入目标状态前执行一次。"]</div>

                            @foreach (var lifecycle in GetLifecycleActions(state))
                            {
                                var actionCall = lifecycle.Action;
                                var actionDescriptor = GetActionDescriptor(actionCall.ActionMethod);

                                if (actionDescriptor is not null)
                                {
                                    NormalizeActionArguments(actionCall, actionDescriptor);
                                }

                                <div class="action-box">
                                    <div class="field-label">@L[lifecycle.Title]</div>

                                    <select class="select"
                                            value="@actionCall.ActionMethod"
                                            @onchange="e => ChangeStateActionMethod(state.Id, lifecycle.Key, e.Value?.ToString() ?? string.Empty)">
                                        <option value="">@L["不调用动作"]</option>
                                        @foreach (var group in ActionMethods.GroupBy(x => x.Group))
                                        {
                                            <optgroup label="@L[group.Key]">
                                                @foreach (var action in group)
                                                {
                                                    <option value="@action.Key">@L[action.DisplayName]</option>
                                                }
                                            </optgroup>
                                        }
                                    </select>

                                    @if (actionDescriptor is not null)
                                    {
                                        <div class="action-parameters">

                                            @if (actionDescriptor.Parameters.Count == 0)
                                            {
                                                
                                            }
                                            else
                                            {
                                                @foreach (var parameter in actionDescriptor.Parameters)
                                                {
                                                    var argument = GetActionArgument(actionCall, parameter.Name)!;
                                                    var editorKind = GetParameterEditorKind(actionCall, parameter);
                                                    var compatibleVariables = GetCompatibleVariables(actionCall, parameter).ToList();

                                                    <div class="action-parameter">
                                                        <div style="display:flex;align-items:center;gap:6px;margin-bottom:5px">
                                                            <div class="field-label" style="margin:0;flex:1">@L[parameter.DisplayName]</div>
                                                        </div>

                                                        <div style="display:grid;grid-template-columns:88px 1fr;gap:6px">
                                                            <select class="select"
                                                                    value="@argument.Source"
                                                                    @onchange='e => ChangeStateActionArgumentSource(
                                                                                    state.Id,
                                                                                    lifecycle.Key,
                                                                                    parameter.Name,
                                                                                    e.Value?.ToString() ?? "literal")'>

<option value="literal">@L["固定值"]</option>

        @if (CanBindGlobalVariable(actionCall, parameter))
                                                                {
                                                                    <option value="variable">@L["全局变量"]</option>
                                                                }
                                                            </select>

                                                            @if (argument.Source == "variable" &&
                                                                 CanBindGlobalVariable(actionCall, parameter))
                                                            {
                                                                <select class="select"
                                                                        value="@argument.VariableName"
                                                                        @onchange="e => ChangeStateActionArgumentVariable(
                                                                                            state.Id,
                                                                                            lifecycle.Key,
                                                                                            parameter.Name,
                                                                                            e.Value?.ToString() ?? string.Empty)">

            @foreach (var variable in compatibleVariables)
                                                                    {
                                                                        <option value="@variable.Name">
                                                                            @variable.Name (@variable.Type)
                                                                        </option>
                                                                    }
                                                                </select>
                                                            }
                                                            else if (editorKind == "boolean")
                                                            {
                                                                <select class="select"
                                                                        value="@argument.LiteralValue"
                                                                        @onchange='e => ChangeStateActionArgumentLiteral(
                                                                                            state.Id,
                                                                                            lifecycle.Key,
                                                                                            parameter.Name,
                                                                                            e.Value?.ToString() ?? "false")'>

<option value="true">true</option>
<option value="false">false</option>
</select>
                                                            }
                                                            else if (editorKind == "enum")
                                                            {
                                                                <select class="select"
                                                                        value="@argument.LiteralValue"
                                                                        @onchange="e => ChangeStateActionArgumentLiteral(
                                                                                            state.Id,
                                                                                            lifecycle.Key,
                                                                                            parameter.Name,
                                                                                            e.Value?.ToString() ?? string.Empty)">

            @foreach (var enumValue in parameter.EnumValues)
                                                                    {
                                                                        <option value="@enumValue">@enumValue</option>
                                                                    }
                                                                </select>
                                                            }
                                                            else if (editorKind == "number")
                                                            {
                                                                <input class="input"
                                                                       type="number"
                                                                       step="any"
                                                                       value="@argument.LiteralValue"
                                                                       @onchange='e => ChangeStateActionArgumentLiteral(
                                                                                          state.Id,
                                                                                          lifecycle.Key,
                                                                                          parameter.Name,
                                                                                          e.Value?.ToString() ?? "0")' />
    }
                                                            else if (editorKind == "datetime")
                                                            {
                                                                <input class="input"
                                                                       type="datetime-local"
                                                                       value="@argument.LiteralValue"
                                                                       @onchange="e => ChangeStateActionArgumentLiteral(
                                                                                          state.Id,
                                                                                          lifecycle.Key,
                                                                                          parameter.Name,
                                                                                          e.Value?.ToString() ?? string.Empty)" />
    }
                                                            else if (editorKind == "date")
                                                            {
                                                                <input class="input"
                                                                       type="date"
                                                                       value="@argument.LiteralValue"
                                                                       @onchange="e => ChangeStateActionArgumentLiteral(
                                                                                          state.Id,
                                                                                          lifecycle.Key,
                                                                                          parameter.Name,
                                                                                          e.Value?.ToString() ?? string.Empty)" />
    }
                                                            else if (editorKind == "time")
                                                            {
                                                                <input class="input"
                                                                       type="time"
                                                                       step="1"
                                                                       value="@argument.LiteralValue"
                                                                       @onchange="e => ChangeStateActionArgumentLiteral(
                                                                                          state.Id,
                                                                                          lifecycle.Key,
                                                                                          parameter.Name,
                                                                                          e.Value?.ToString() ?? string.Empty)" />
    }
                                                            else if (editorKind == "json")
                                                            {
                                                                <textarea class="input"
                                                                          rows="3"
                                                                          @onchange="e => ChangeStateActionArgumentLiteral(
                                                                                                state.Id,
                                                                                                lifecycle.Key,
                                                                                                parameter.Name,
                                                                                                e.Value?.ToString() ?? string.Empty)">@argument.LiteralValue</textarea>
    }
                                                            else
                                                            {
                                                                <input class="input"
                                                                       value="@argument.LiteralValue"
                                                                       @onchange="e => ChangeStateActionArgumentLiteral(
                                                                                          state.Id,
                                                                                          lifecycle.Key,
                                                                                          parameter.Name,
                                                                                          e.Value?.ToString() ?? string.Empty)" />
    }
                                                        </div>


                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="group">
                            <div class="group-header">
                                <div class="group-title">@L["切换出口"]</div>
                                <button class="btn small" @onclick="() => AddOutput(state.Id)">@L["+ 插头"]</button>
                            </div>
                            <div class="hint">@L["从上往下就是切换优先级。"]</div>
                            <div style="margin-top:8px">
                                @for (var outputIndex = 0; outputIndex < state.Outputs.Count; outputIndex++)
                                {
                                    var output = state.Outputs[outputIndex];
                                    var connected = GetEdgeFromPort(state.Id, output.Id) is not null;
                                    <div class="transition-editor" @key="output.Id">
                                        <div class="transition-head">
                                            <input class="input" value="@output.Name" @oninput="e => RenameOutput(state.Id, output.Id, e.Value?.ToString() ?? string.Empty)" />
                                            <button class="mini-btn" @onclick="() => MoveOutput(state.Id, output.Id, -1)">↑</button>
                                            <button class="mini-btn" @onclick="() => MoveOutput(state.Id, output.Id, 1)">↓</button>
                                            <button class="remove-btn" @onclick="() => RemoveOutput(state.Id, output.Id)">×</button>
                                        </div>
                                        <div style="margin-bottom:7px;color:#65738a;font-size:9px">@L.Format("优先级：{0}", outputIndex + 1) · @(connected ? L["已连接"] : L["未连接"])</div>
                                        <div class="transition-grid">
                                            <div style="display:flex;align-items:center;color:#748298;font-size:9px">@L["条件组合"]</div>
                                            <select class="select" value="@output.MatchMode" @onchange='e => ChangeOutputMatchMode(state.Id, output.Id, e.Value?.ToString() ?? "all")'>
                                                <option value="all">@L["ALL 全部成立"]</option>
                                                <option value="any">@L["ANY 任意成立"]</option>
                                                <option value="always">@L["ALWAYS 无条件"]</option>
                                            </select>
                                        </div>

                                        @if (output.MatchMode != "always")
                                        {
                                            @for (var conditionIndex = 0; conditionIndex < output.Conditions.Count; conditionIndex++)
                                            {
                                                var condition = output.Conditions[conditionIndex];
                                                <div class="condition-editor" @key="condition.Id">
                                                    <div class="condition-index">@L.Format("条件 {0}", conditionIndex + 1)</div>
                                                    <div class="recognition-condition-row">
                                                        <select class="select" aria-label="@L["选择出口判断项目"]" value="@ConditionTarget(condition)" @onchange="e => ChangeConditionTarget(condition, e.Value?.ToString() ?? string.Empty)">
                                                            <option value="" disabled>@L["选择变量或库中的名称"]</option>
                                                            <optgroup label="@L["全局变量"]">
                                                                @foreach (var variable in Machine.Variables)
                                                                {
                                                                    <option value="@($"variable:{variable.Id}")">@variable.Name</option>
                                                                }
                                                            </optgroup>
                                                            <optgroup label="@L["多点色库"]">
                                                                @foreach (var item in Machine.Recognitions.Where(i => !i.IsFolder && i.Settings.Mode == "feature"))
                                                                {
                                                                    <option value="@($"recognition:{item.Id}")">@RecognitionPath(item)</option>
                                                                }
                                                            </optgroup>
                                                            <optgroup label="@L["字典库"]">
                                                                @foreach (var item in Machine.Recognitions.Where(i => i.Settings.Mode == "dictionary"))
                                                                {
                                                                    <option value="@($"recognition:{item.Id}")">@RecognitionPath(item)</option>
                                                                }
                                                            </optgroup>
                                                        </select>
                                                        <button class="remove-btn" @onclick="() => RemoveCondition(state.Id, output.Id, condition.Id)">×</button>
                                                    </div>
                                                    @if (condition.Kind == "recognition")
                                                    {
                                                        var criteria = RecognitionCriteriaFor(condition);
                                                        @if (IsDictionaryCondition(condition))
                                                        {
                                                            <div class="recognition-filter-row">
                                                                <label>@L["字典用途"]</label>
                                                                <select class="select" value="@DictionaryModeFor(condition)" @onchange='e => ChangeDictionaryMode(condition, e.Value?.ToString() ?? "ocr")'>
                                                                    <option value="ocr">@L["OCR 结果判断"]</option><option value="text">@L["查找固定文字"]</option>
                                                                </select>
                                                            </div>
                                                            @if (DictionaryModeFor(condition) == "text")
                                                            {
                                                                <div class="recognition-filter-row">
                                                                    <label>@L["查找文字"]</label>
                                                                    <input class="input" placeholder="@L["必须填写固定文字，例如：确定"]" value="@(criteria.SearchText ?? Machine.Recognitions.FirstOrDefault(i => i.Id == condition.RecognitionId)?.Settings.Query)" @onchange="e => { criteria.SearchText = e.Value?.ToString() ?? string.Empty; RefreshCurrentConditionResults(); }" />
                                                                </div>
                                                                <div class="hint">@L["在所选字典中匹配这段固定文字，按找到／未找到判断。"]</div>
                                                            }
                                                            else
                                                            {
                                                                <div class="hint">@L["用所选字典识别搜索区文字，再按下方“识别文字”等结果判断。"]</div>
                                                            }
                                                        }
                                                        <div class="recognition-filter-row">
                                                            <label>@L["识别结果"]</label>
                                                            <select class="select" value="@RecognitionSuccessValue(condition)" @onchange='e => ChangeRecognitionSuccess(condition, e.Value?.ToString() ?? "ignore")'>
                                                                <option value="ignore">@L["不判断"]</option><option value="success">@L["成功"]</option><option value="failure">@L["失败"]</option>
                                                            </select>
                                                        </div>
                                                        <div class="recognition-filter-row numeric">
                                                            <label>@L["相似度 %"]</label>
                                                            <select class="select" @bind="criteria.SimilarityOperator" @bind:after="RefreshCurrentConditionResults">
                                                                @foreach (var op in NumericRecognitionOperators) { <option value="@op">@op</option> }
                                                            </select>
                                                            <input class="input" type="number" min="0" max="100" step="any" placeholder="@L["留空不判断"]" @bind="criteria.Similarity" @bind:after="RefreshCurrentConditionResults" />
                                                        </div>
                                                        <div class="recognition-filter-row numeric">
                                                            <label>@L["坐标 X"]</label>
                                                            <select class="select" @bind="criteria.XOperator" @bind:after="RefreshCurrentConditionResults">
                                                                @foreach (var op in NumericRecognitionOperators) { <option value="@op">@op</option> }
                                                            </select>
                                                            <input class="input" type="number" placeholder="@L["留空不判断"]" @bind="criteria.X" @bind:after="RefreshCurrentConditionResults" />
                                                        </div>
                                                        <div class="recognition-filter-row numeric">
                                                            <label>@L["坐标 Y"]</label>
                                                            <select class="select" @bind="criteria.YOperator" @bind:after="RefreshCurrentConditionResults">
                                                                @foreach (var op in NumericRecognitionOperators) { <option value="@op">@op</option> }
                                                            </select>
                                                            <input class="input" type="number" placeholder="@L["留空不判断"]" @bind="criteria.Y" @bind:after="RefreshCurrentConditionResults" />
                                                        </div>
                                                        <div class="recognition-filter-row numeric">
                                                            <label>@L["识别文字"]</label>
                                                            <select class="select" @bind="criteria.TextOperator" @bind:after="RefreshCurrentConditionResults">
                                                                <option value="contains">@L["包含"]</option><option value="==">@L["等于"]</option><option value="!=">@L["不等于"]</option><option value="startsWith">@L["开头"]</option><option value="endsWith">@L["结尾"]</option>
                                                            </select>
                                                            <input class="input" placeholder="@L["留空不判断"]" @bind="criteria.Text" @bind:after="RefreshCurrentConditionResults" />
                                                        </div>
                                                        <div class="hint">@L["填写的项目同时满足才成立，留空的项目不参与判断。"]</div>
                                                        <button class="btn small" @onclick="() => OpenRecognitionManager(condition.RecognitionId)">@L["编辑识别项目"]</button>
                                                        <button class="btn small" disabled="@(_executing || Runtime.Running)" @onclick="() => TestRecognitionConditionAsync(condition)">@L["测试当前条件"]</button>
                                                        <div class="hint" style="white-space:pre-wrap">@RecognitionConditionResult(condition)</div>
                                                    }

                                                    else
                                                    {
                                                    <div class="recognition-filter-row">
                                                        <label>@L["比较方式"]</label>
                                                        <select class="select" value="@condition.Operator" @onchange='e => ChangeConditionOperator(state.Id, output.Id, condition.Id, e.Value?.ToString() ?? "==")'>
                                                            @foreach (var op in Operators)
                                                            {
                                                                <option value="@op">@op</option>
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="condition-row-b">
                                                        <select class="select" value="@condition.RightMode" @onchange='e => ChangeConditionRightMode(state.Id, output.Id, condition.Id, e.Value?.ToString() ?? "literal")'>
                                                            <option value="literal">@L["固定值"]</option>
                                                            <option value="variable">@L["全局变量"]</option>
                                                        </select>
                                                        @if (condition.RightMode == "literal")
                                                        {
                                                            <select class="select" value="@condition.RightType" @onchange='e => ChangeConditionRightType(state.Id, output.Id, condition.Id, e.Value?.ToString() ?? "string")'>
                                                                <option value="number">number</option>
                                                                <option value="string">string</option>
                                                                <option value="boolean">boolean</option>
                                                            </select>
                                                        }
                                                        else
                                                        {
                                                            <div style="display:flex;align-items:center;padding-left:7px;color:#67758d;font-size:9px">@L["与另一个全局变量比较"]</div>
                                                        }
                                                    </div>
                                                    <div class="condition-row-c">
                                                        <div style="display:flex;align-items:center;color:#718097;font-size:9px">@L["右值"]</div>
                                                        @if (condition.RightMode == "variable")
                                                        {
                                                            <select class="select" value="@NodeString(condition.RightValue)" @onchange="e => ChangeConditionRightValue(state.Id, output.Id, condition.Id, e.Value?.ToString() ?? string.Empty)">
                                                                @if (Machine.Variables.Count == 0)
                                                                {
                                                                    <option value="">@L["没有变量"]</option>
                                                                }
                                                                else
                                                                {
                                                                    @foreach (var variable in Machine.Variables)
                                                                    {
                                                                        <option value="@variable.Name">@variable.Name</option>
                                                                    }
                                                                }
                                                            </select>
                                                        }
                                                        else if (condition.RightType == "boolean")
                                                        {
                                                            <select class="select" value='@DisplayNode(condition.RightValue, "boolean")' @onchange='e => ChangeConditionRightValue(state.Id, output.Id, condition.Id, e.Value?.ToString() ?? "false")'>
                                                                <option value="true">true</option>
                                                                <option value="false">false</option>
                                                            </select>
                                                        }
                                                        else
                                                        {
                                                            <input class="input" value="@DisplayNode(condition.RightValue, condition.RightType)" @onchange="e => ChangeConditionRightValue(state.Id, output.Id, condition.Id, e.Value?.ToString() ?? string.Empty)" />
                                                        }
                                                    </div>
                                                    }
                                                </div>
                                            }
                                            <button class="btn small" style="margin-top:6px" @onclick="() => AddCondition(state.Id, output.Id)">@L["+ 条件"]</button>
                                        }
                                        else
                                        {
                                            <div class="hint">@L["无条件出口如果优先级最高，会让后面的出口永远没有机会执行。"]</div>
                                        }

                                    </div>
                                }
                            </div>
                        </div>
                        <button class="danger" @onclick="DeleteSelectedState">@L["删除整个状态"]</button>
                    }
                </div>
            </div>
        </aside>
    </div>

    <div class="bottom">
        <div class="log-panel">
            <div class="bottom-header">
                <div id="runtimeDot" class="status-dot @(Runtime.Running ? "running" : "")"></div>
                <span id="runtimeStatus">@(Runtime.Running ? "RUNNING" : "STOPPED")</span>
                <div class="spacer"></div>
                <button class="btn small" @onclick="ClearLogs">@L["清空"]</button>
            </div>
            <div id="console">
                @foreach (var log in Logs)
                {
                    <div @key="log.Id">
                        <span class="log-time">@log.Time</span>
                        <span class="log-@log.Level">[@log.Type]</span>
                        <span class="log-@log.Level">@log.Message</span>
                    </div>
                }
            </div>
        </div>

        <div class="runtime-panel">
            <div class="bottom-header">@L["运行时"]</div>
            <div class="runtime-content">
                <div id="runtimeRegions" class="runtime-regions">
                    @foreach (var region in Machine.Regions)
                    {
                        var state = GetCurrentState(region.Id);
                        <div class="runtime-region" @key="region.Id">
                            <div class="runtime-region-name">@region.Name</div>
                            <div class="runtime-state-name">@(state?.Name ?? "-")</div>
                        </div>
                    }
                </div>
                <div id="runtimeVariables" class="runtime-vars">
                    @foreach (var variable in Machine.Variables)
                    {
                        Runtime.Variables.TryGetValue(variable.Name, out var runtimeValue);
                        <div class="runtime-var-row" @key="variable.Id">
                            <div class="runtime-var-name">@variable.Name</div>
                            <div class="runtime-var-type">@variable.Type</div>
                            @if (variable.Type == "boolean")
                            {
                                <select class="runtime-value" value="@DisplayNode(runtimeValue, variable.Type)" @onchange='e => ChangeRuntimeVariable(variable.Id, e.Value?.ToString() ?? "false")'>
                                    <option value="true">true</option>
                                    <option value="false">false</option>
                                </select>
                            }
                            else
                            {
                                <input class="runtime-value" value="@DisplayNode(runtimeValue, variable.Type)" @onchange="e => ChangeRuntimeVariable(variable.Id, e.Value?.ToString() ?? string.Empty)" />
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>



@if (_aiDialogOpen)
{
    <div class="ai-overlay" @onclick="CloseAiDialog">

        <div class="ai-dialog" @onclick:stopPropagation="true">

            <!-- 顶部 -->
